(function () {
  try {
    var root = document.documentElement;
    var pref = localStorage.getItem("wzz:theme") || "auto";
    var dark = pref === "dark" ||
      (pref === "auto" && window.matchMedia("(prefers-color-scheme: dark)").matches);
